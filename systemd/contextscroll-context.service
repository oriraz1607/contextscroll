[Unit]
Description=ContextScroll semantic UI context helper
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/contextscroll-context
Restart=on-failure
RestartSec=2

# The helper talks only to the user's AT-SPI/session buses, GNOME pointer
# bridge or XWayland socket, and the daemon's Unix socket. It never reads raw
# input devices and has no elevated privilege.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# Hide application data. Expose only the small set of per-user files needed
# by dconf, legacy AT-SPI discovery, and X11 authentication.
ProtectHome=tmpfs
BindReadOnlyPaths=-%h/.config/dconf/user
BindReadOnlyPaths=-%h/.cache/at-spi
BindReadOnlyPaths=-%h/.Xauthority
# ProtectHome also hides /run/user. Fedora gives accessibility-enabled
# processes randomized AT-SPI socket directories there, so the helper needs
# the session runtime directory to remain visible. Keep it read-only except
# for dconf's shared-memory directory.
BindReadOnlyPaths=%t
RuntimeDirectory=dconf
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/dconf
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# PrivateTmp hides the filesystem X socket while PrivateNetwork hides its
# abstract-socket twin. Expose only the X11/XWayland socket directory.
BindReadOnlyPaths=-/tmp/.X11-unix
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RemoveIPC=yes
KeyringMode=private
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
MemoryMax=192M
TasksMax=32
UMask=0077

[Install]
WantedBy=graphical-session.target
